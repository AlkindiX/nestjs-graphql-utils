{
  "compilerOptions": {
    "target": "es2017",
    "module": "node20",
    "moduleResolution": "node16",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "incremental": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
